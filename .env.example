# Copy to .env only for local development. Never commit real credentials.
ROLEREADY_SUPABASE_URL=https://your-project-ref.supabase.co
ROLEREADY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server/worker only. Never put this value in VITE_* or frontend code.
ROLEREADY_SUPABASE_SECRET_KEY=
ROLEREADY_SUPABASE_TIMEOUT_SECONDS=15
# Backend only. Never use a VITE_GEMINI_* variable or commit a real key.
ROLEREADY_GEMINI_API_KEY=
ROLEREADY_GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
ROLEREADY_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ROLEREADY_GEMINI_EMBEDDING_DIMENSIONS=384
ROLEREADY_GEMINI_TIMEOUT_SECONDS=45
ROLEREADY_GEMINI_MAX_RETRIES=3
ROLEREADY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://your-lovable-preview.lovable.app
# Set these only after training produces and verifies a checkpoint.
# Docker Compose also requires FAIRHIRE_MODEL_DIR to point at the host
# directory mounted read-only at /models; it intentionally has no dummy default.
FAIRHIRE_MODEL_DIR=
ROLEREADY_MODEL_CHECKPOINT_PATH=
ROLEREADY_MODEL_RUN_NAME=
ROLEREADY_MODEL_CHECKPOINT_SHA256=
# These two override the original machine paths saved inside best.pt.
ROLEREADY_BERT_MODEL_ROOT=
ROLEREADY_SCALER_PATH=
# Worker-only runtime paths. OpenFace must include its downloaded model files.
ROLEREADY_OPENFACE_ROOT=
ROLEREADY_WHISPER_MODEL_ROOT=
ROLEREADY_WHISPER_MODEL=small.en
ROLEREADY_WORKER_ARTIFACT_ROOT=
# Optional explicit FFmpeg executable; imageio-ffmpeg is used when omitted.
ROLEREADY_FFMPEG_PATH=
