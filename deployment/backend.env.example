# Public HTTPS API service. Copy to deployment/backend.env for local Docker
# verification, or enter these values in the hosting provider's secret manager.
ROLEREADY_SUPABASE_URL=https://your-project-ref.supabase.co
ROLEREADY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
ROLEREADY_GEMINI_API_KEY=
ROLEREADY_GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
ROLEREADY_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ROLEREADY_GEMINI_EMBEDDING_DIMENSIONS=384
ROLEREADY_CORS_ALLOWED_ORIGINS=https://your-final-frontend.example

# Set true only after the separate trusted GPU worker passes its preflight and
# is running under a supervisor. Never put the Supabase secret in this file.
ROLEREADY_TRUSTED_WORKER_AVAILABLE=true
